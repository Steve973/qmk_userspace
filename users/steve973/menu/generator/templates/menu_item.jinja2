{# Debug output at start of template processing #}
{# {{ item.label }} #}
{# {{ "Has operation" if item.operation else "No operation" }} #}
{# {{ "Has children: " ~ item.children|length if item.children else "No children" }} #}

{#
  Top-level display content macro - used throughout template to generate
  display_content_t and display_element_t structures. Moved to top for global scope.
#}
{% macro render_display_content(content, name) %}
static const display_element_t {{ name }}_elements[] = {
    {% for element in content.elements %}
    {
        .type = DISPLAY_TYPE_{{ element.type.name }},
        .text = "{{ element.text|replace('\n', '\\n') }}",
        .is_selectable = {{ element.is_selectable|lower }}
    }{{ "," if not loop.last }}
    {% endfor %}
};

static const display_content_t {{ name }}_display = {
    .title = "{{ content.title }}",
    .elements = {{ name }}_elements,
    .element_count = {{ content.elements|length }}
};
{% endmacro %}

{# Generate operation-related display content for all operation phases #}
{% if item.operation %}
    {# Generate display content for each operation phase #}
    {% if item.operation.precondition %}
    static const struct precondition_config {{ name }}_precondition = {
        .base_config = {
            .title = "{{ item.operation.precondition.title }}",
            .message = "{{ item.operation.precondition.message|replace('\n', '\\n') }}",
            .timeout_sec = {{ item.operation.precondition.timeout_sec|default(0) }}
        },
        .button = {
            .ok_text = "{{ item.operation.precondition.ok_text or 'OK' }}"
        },
        .handler = "{{ item.operation.precondition.handler }}",
        .args = {{ item.operation.precondition.args if item.operation.precondition.args else "NULL" }}
    };
    {% set precondition_display = item.operation.get_display_content('precondition') %}
    {% if precondition_display %}
        {{ render_display_content(precondition_display, name ~ '_precondition') }}
    {% endif %}
    {% endif %}

    {% if item.operation.inputs %}
        {# First generate option arrays needed for input configs #}
        {% for input in item.operation.inputs %}
            {% if input.type.name == "OPTIONS" %}
    static const char* const {{ name }}_input{{ loop.index0 }}_options[] = {
                {% for option in input.options %}
        "{{ option }}",
                {% endfor %}
    };
            {% endif %}
        {% endfor %}

        {# Then generate the input configs that can reference those arrays #}
    static const struct input_config {{ name }}_inputs[] = {
        {% for input in item.operation.inputs %}
        {
            .type = INPUT_TYPE_{{ input.type.name }},
            .title = "{{ input.title }}",
            .prompt = "{{ input.prompt|replace('\n', '\\n') }}",
            .default_val = "{{ input.default }}",
            .wrap = {{ input.wrap|lower }},
            .live_preview = {{ input.live_preview|default(false)|lower }},
            .data = {
                {% if input.type.name == "RANGE" %}
                .range = {
                    .min = {{ input.range.split("..")[0] }},
                    .max = {{ input.range.split("..")[1].split(":")[0] }},
                    .step = {{ input.range.split(":")[1] }}
                }
                {% elif input.type.name == "OPTIONS" %}
                .options = {
                    .options = {{ name }}_input{{ loop.index0 }}_options,
                    .option_count = {{ input.options|length }}
                }
                {% endif %}
            }
        }{{ "," if not loop.last }}
        {% endfor %}
    };

        {% set input_display = item.operation.get_display_content('input') %}
        {% if input_display %}
            {{ render_display_content(input_display, name ~ '_input') }}
        {% endif %}
    {% endif %}

    {% if item.operation.confirm %}
    static const struct confirm_config {{ name }}_confirm = {
        .base_config = {
            .title = "{{ item.operation.confirm.title }}",
            .message = "{{ item.operation.confirm.message|replace('\n', '\\n') }}",
            .timeout_sec = {{ item.operation.confirm.timeout_sec|default(0) }}
        },
        .buttons = {
            .true_text = "{{ item.operation.confirm.true_text or 'Yes' }}",
            .false_text = "{{ item.operation.confirm.false_text or 'No' }}"
        }
    };
    {% set confirm_display = item.operation.get_display_content('confirm') %}
    {% if confirm_display %}
        {{ render_display_content(confirm_display, name ~ '_confirm') }}
    {% endif %}
    {% endif %}

    {% set action_display = item.operation.get_display_content('action') %}
    {% if action_display %}
        {{ render_display_content(action_display, name ~ '_action') }}
    {% endif %}

    {% if item.operation.result %}
    static const struct result_config {{ name }}_result = {
        .base_config = {
            .title = "{{ item.operation.result.title }}",
            .message = "{{ item.operation.result.message|replace('\n', '\\n') }}",
            .timeout_sec = {{ item.operation.result.timeout_sec|default(0) }}
        },
        .button = {
            .ok_text = "{{ item.operation.result.ok_text or 'OK' }}"
        }
    };
    {% set result_display = item.operation.get_display_content('result') %}
    {% if result_display %}
        {{ render_display_content(result_display, name ~ '_result') }}
    {% endif %}
    {% endif %}

    {% if item.operation.postcondition %}
    static const struct postcondition_config {{ name }}_postcondition = {
        .base_config = {
            .title = "{{ item.operation.postcondition.title }}",
            .message = "{{ item.operation.postcondition.message|replace('\n', '\\n') }}",
            .timeout_sec = {{ item.operation.postcondition.timeout_sec|default(0) }}
        },
        .button = {
            .ok_text = "{{ item.operation.postcondition.ok_text or 'OK' }}"
        },
        .handler = "{{ item.operation.postcondition.handler }}",
        .args = {{ item.operation.postcondition.args if item.operation.postcondition.args else "NULL" }}
    };
    {% set postcondition_display = item.operation.get_display_content('postcondition') %}
    {% if postcondition_display %}
        {{ render_display_content(postcondition_display, name ~ '_postcondition') }}
    {% endif %}
    {% endif %}
{% endif %}

{# Generate menu's own display content (separate from operation displays) #}
{% set menu_display = item.get_display_content() %}
{% if menu_display %}
    {{ render_display_content(menu_display, name) }}
{% endif %}

{# Generate condition rules if present #}
{% if item.conditions and item.conditions.rules %}
static const struct condition_rule_config {{ name }}_rules[] = {
    {% for rule in item.conditions.rules %}
    {
        {% if rule.type == "value_equals" %}
        .type = RULE_VALUE_EQUALS,
        .rule_data = {
            .value_equals = {
                .variable = "{{ rule.variable }}",
                .value = "{{ rule.value }}"
            }
        }
        {% elif rule.type == "value_compare" %}
        .type = RULE_VALUE_COMPARE,
        .rule_data = {
            .value_compare = {
                .variable = "{{ rule.variable }}",
                .value = "{{ rule.value }}",
                .operator = COMPARE_{{ rule.operator|upper }}
            }
        }
        {% endif %}
    }{{ "," if not loop.last }}
    {% endfor %}
};
{% endif %}

{# Generate children array for submenu types #}
{% if item.children %}
static const menu_item_t* const {{ name }}_children[] = {
    {%- for child in child_names -%}
    &{{ child }}{{ ", " if not loop.last else "" }}
    {%- endfor -%}
};
{% endif %}

{# Generate the menu item structure, referencing all previously generated components #}
static const menu_item_t {{ name }} = {
    .label = "{{ item.label|replace('\n', '\\n') }}",
    .label_short = "{{ item.label_short or ''|replace('\n', '\\n') }}",
    .icon = "{{ item.icon or '' }}",
    .shortcut = "{{ item.shortcut or '' }}",
    .type = MENU_TYPE_{{ item.type.name }},
    .help_text = "{{ (item.help_text or '')|replace('\n', '\\n') }}",
    .operation = {
        .action = {% if item.operation %}"{{ item.operation.action }}"{% else %}NULL{% endif %},
        .inputs = {% if item.operation and item.operation.inputs %}{{ name }}_inputs{% else %}NULL{% endif %},
        .confirm = {% if item.operation and item.operation.confirm %}&{{ name }}_confirm{% else %}NULL{% endif %},
        .result = {% if item.operation and item.operation.result %}&{{ name }}_result{% else %}NULL{% endif %},
        .precondition_display = {% if precondition_display %}&{{ name }}_precondition_display{% else %}NULL{% endif %},
        .input_display = {% if input_display %}&{{ name }}_input_display{% else %}NULL{% endif %},
        .confirm_display = {% if confirm_display %}&{{ name }}_confirm_display{% else %}NULL{% endif %},
        .action_display = {% if action_display %}&{{ name }}_action_display{% else %}NULL{% endif %},
        .result_display = {% if result_display %}&{{ name }}_result_display{% else %}NULL{% endif %},
        .postcondition_display = {% if postcondition_display %}&{{ name }}_postcondition_display{% else %}NULL{% endif %}
    },
    .conditions = {% if item.conditions %}{
        .match = CONDITION_MATCH_ALL,
        .rules = {{ name }}_rules,
        .rule_count = 1
    }{% else %}{0}{% endif %},
    .children = {% if item.children %}{{ name }}_children{% else %}NULL{% endif %},
    .child_count = {{ child_names|length if item.children else 0 }},
    .display = {% if menu_display %}&{{ name }}_display{% else %}NULL{% endif %},
    .screen_content = {% if item.screen_content %}&{{ item.screen_content }}{% else %}NULL{% endif %}
};
